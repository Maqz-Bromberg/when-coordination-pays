# Papers, theses and archives stay out of git, except papers/hosted/: the openly licensed papers and the author's own
# work that the public site serves (references.bib `file` fields), committed so the GitHub Pages build can copy them
papers/*
!papers/hosted/
*.pdf
!papers/hosted/*.pdf
*.zip

# Read-only clones of the thesis repos and the extracted thesis source (see reference/README.md)
reference/*
!reference/README.md

# Experiment output (summaries for the site live in data/site/)
data/raw/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/

# Local only
/web*

# Editors / OS
.vscode/
.idea/
.DS_Store

# Python build output
py/build/
py/dist/
*.whl
site/node_modules/
site/.next/
site/out/
site/next-env.d.ts
site/tsconfig.tsbuildinfo
paper/build/
# Paper build outputs (regenerated by `make figures tables paper` and in CI)
paper/figures/
paper/generated/
paper/build.log
site/public/paper.pdf
.figserver.pid
site/public/data/
site/public/papers/

# bits and bobs
permission-email.md
claude-questions.md
site/public/downloads/
